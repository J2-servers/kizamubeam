   "texts": {
    "en": {
     "name": "Rulers and scales",
     "desc": "Ruler, protractor or scale dial with engraved ticks and numbers at their exact positions.",
     "keys": "ruler protractor scale dial gauge measure inch",
     "label": "Scale",
     "part.straight": "ruler",
     "part.protractor": "protractor",
     "part.dial": "dial",
     "type": "Type",
     "type.straight": "Straight ruler",
     "type.protractor": "Protractor",
     "type.dial": "Dial",
     "units": "Units",
     "units.metric": "Metric (mm, cm)",
     "units.inch": "Inch",
     "length": "Scale length",
     "inches": "Length in inches",
     "sub": "Finest division",
     "sub.2": "1/2 inch",
     "sub.4": "1/4 inch",
     "sub.8": "1/8 inch",
     "sub.16": "1/16 inch",
     "width": "Ruler width",
     "radius": "Scale radius",
     "sweep": "Angle range",
     "sweep.title": "180° = half circle, 360° = full dial. The scale is centred at the top.",
     "divisions": "Main divisions",
     "minorPer": "Steps per division",
     "startValue": "First number",
     "step": "Smallest step",
     "section.ticks": "Ticks",
     "major": "Main tick length",
     "half": "Half tick length",
     "minor": "Small tick length",
     "section.numbers": "Numbers",
     "numbers": "Numbers",
     "numberSize": "Number height",
     "numberEvery": "Number every n-th main tick",
     "rotate": "Turn numbers with the scale",
     "labels": "Own labels",
     "labels.title": "Comma-separated, one per numbered tick (e.g. MIN,1,2,3,MAX). Empty = numbers.",
     "unitText": "Unit (CM / IN)",
     "section.body": "Body",
     "margin": "Margin",
     "corner": "Corner radius",
     "hole": "Hole",
     "holeDia": "Hole diameter",
